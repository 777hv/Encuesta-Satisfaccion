<?xml version="1.0" encoding="utf-8"?>
<!-- Ignora la config global del equipo (fallback de Visual Studio y mapeo de fuentes) -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
